# Per-environment workload configuration (T-104 API contract: "the home
# workspace id, the nexora_api item id and the nexora_stage_runner item id
# live in the workload configuration, not in source"). Values below are
# placeholders for the test Nexora home workspace; fill them in after running
# `python -m app.tools.deploy_home --env test` (T-005) and publishing the
# nexora_api item's `call`/`me` functions with public access enabled (T-102).
ITEM_NAMES=NexoraRunItem
NEXORA_HOME_WORKSPACE_ID=
NEXORA_STAGE_RUNNER_ITEM_ID=
NEXORA_API_CALL_FUNCTION_URL=
NEXORA_API_ME_FUNCTION_URL=

    <ItemName>
      <Default>Nexora Run</Default>
    </ItemName>
    <ItemDescription>
      <Default>A Nexora run: a business requirement being turned into an approved semantic model and report.</Default>
    </ItemDescription>
  </Item>
</ItemManifestConfiguration>

APP_NAME=Nexora
UI_APP_NAME=Rayfin
ENVIRONMENT=development
LLM_PROVIDER=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Secrets (T-705): with KEY_VAULT_URL set, the model key (secret azure-openai-api-key) and the API client
# secret (entra-api-client-secret) are read from Azure Key Vault and these two stay empty here.
KEY_VAULT_URL=
AZURE_OPENAI_API_KEY=

FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_SANDBOX_WORKSPACE_ID=
SANDBOX_WORKSPACE_ID=

RUN_STORE=file
ARTIFACT_STORE=local
FABRIC_CONTROL_DB_SERVER=
FABRIC_CONTROL_DB_NAME=

# The Nexora home workspace's own items (T-005). Written by deploy_home into the
# Variable library in Fabric; set locally only for development against a home workspace.
NEXORA_HOME_WORKSPACE_ID=
NEXORA_CONTROL_LAKEHOUSE_ID=
NEXORA_STAGE_RUNNER_ID=

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=

# Telemetry (T-704): eventhouse | azuremonitor | console. Empty means no export locally;
# inside a Fabric job or UDF, empty defaults to eventhouse.
OTEL_EXPORTER=
APPLICATIONINSIGHTS_CONNECTION_STRING=
NEXORA_EVENTHOUSE_URI=
NEXORA_EVENTHOUSE_DATABASE=

# Run authorization cache (T-705): a SQL-backed `dbo.nexora_run_access` when RUN_STORE=fabric_sql
# re-uses FABRIC_CONTROL_DB_SERVER/NAME above; nothing new to set for it.
